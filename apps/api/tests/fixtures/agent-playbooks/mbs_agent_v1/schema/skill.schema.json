{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["stableId", "title", "toolSequence"],
  "properties": {
    "stableId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "requestIdPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["DETERMINISTIC"] },
        "includeCorrelationId": { "type": "boolean" }
      }
    },
    "toolSequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stableId", "toolName"],
        "properties": {
          "stableId": { "type": "string", "minLength": 1 },
          "toolName": { "type": "string", "minLength": 1 },
          "payload": { "type": "object", "additionalProperties": true },
          "passInputs": { "type": "boolean" },
          "requiresRequestId": { "type": "boolean" },
          "requestIdField": { "type": "string", "minLength": 1 },
          "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "retryOnRecoverableFailure": { "type": "boolean" },
          "keyInputFields": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
