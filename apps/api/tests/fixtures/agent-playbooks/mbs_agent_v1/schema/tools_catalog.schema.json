{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools"],
  "properties": {
    "packId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolName"],
        "properties": {
          "toolName": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
