{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mbs.local/schemas/playbook.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["stableId", "title", "status", "requiresTools", "skillSequence"],
  "properties": {
    "stableId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["READY", "SPEC_ONLY"] },
    "requiresTools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "skillSequence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
