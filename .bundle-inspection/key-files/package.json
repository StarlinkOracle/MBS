{
  "name": "russell-comfort-solutions-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,worker,agent \"npm run dev -w @rcs/api\" \"npm run dev -w @rcs/web\" \"npm run dev -w @rcs/worker\" \"npm run dev -w @rcs/agent\"",
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "db:generate": "npm run prisma:generate -w @rcs/db",
    "db:migrate:dev": "npm run migrate:dev -w @rcs/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @rcs/db",
    "db:seed": "npm run seed -w @rcs/db",
    "legal-pack:import": "node scripts/import-legal-pack.ts",
    "external-packs:manifest:generate": "node scripts/generate-external-pack-manifest.mjs",
    "external-packs:manifest:verify": "node scripts/verify-external-pack-manifest.mjs",
    "ops:health": "bash scripts/ops/check_system_health.sh",
    "ops:health:json": "bash scripts/ops/check_system_health.sh --json",
    "ops:health:alert": "bash scripts/ops/health_check_and_alert.sh",
    "ops:health:remediate:dry-run": "bash scripts/ops/remediate_from_health.sh",
    "ops:health:remediate": "bash scripts/ops/remediate_from_health.sh --apply",
    "ops:health:remediate:aggressive": "bash scripts/ops/remediate_from_health.sh --apply --aggressive-disk",
    "ops:backup:verify": "bash scripts/ops/verify_backup_snapshot.sh",
    "ops:backup:verify:json": "bash scripts/ops/verify_backup_snapshot.sh --json",
    "ops:load:smoke": "bash scripts/ops/load_smoke.sh",
    "ops:load:smoke:json": "bash scripts/ops/load_smoke.sh --json",
    "ops:load:smoke:record": "bash scripts/ops/load_smoke_record.sh",
    "ops:launchd:health": "bash scripts/ops/check_launchd_health.sh",
    "ops:launchd:repair": "bash scripts/ops/repair_launchd_jobs.sh",
    "ops:launchd:repair:run-health": "bash scripts/ops/repair_launchd_jobs.sh --run-health-now",
    "ops:disk:status": "bash scripts/ops/recover_disk_pressure.sh --status",
    "ops:disk:recover": "bash scripts/ops/recover_disk_pressure.sh --prune-safe",
    "ops:disk:recover:aggressive": "bash scripts/ops/recover_disk_pressure.sh --prune-aggressive"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
