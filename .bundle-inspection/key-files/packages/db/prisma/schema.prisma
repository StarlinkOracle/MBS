generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AutonomyLevel {
  ALWAYS_ALLOWED
  REQUIRES_APPROVAL
  REQUIRES_2ND_APPROVAL
  NEVER_AUTONOMOUS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ExecutionStatus {
  QUEUED_APPROVAL
  BLOCKED
  EXECUTED
  FAILED
  CANCELLED
}

enum ActorType {
  HUMAN
  AGENT
  SYSTEM
}

enum AgentRunStatus {
  RUNNING
  PAUSED_FOR_APPROVALS
  COMPLETED
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum SafetyMode {
  NORMAL
  AUTONOMY_OFF
  FULL_STOP
}

enum ImportProvider {
  JOBBER
}

enum ImportMode {
  CSV
}

enum ImportRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AttributionSourceType {
  WEB_FORM
  CHAT
  BOOKING
  CALL
  IMPORT
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum AttachmentKind {
  RECEIPT
  JOB_PHOTO
  QUOTE_PHOTO
  DOCUMENT
}

enum AttachmentStorageProvider {
  S3
}

enum AttachmentOwnerType {
  QUOTE
  JOB
}

enum AttachmentTag {
  BEFORE
  AFTER
  EQUIPMENT_PLATE
  RECEIPT
  PROBLEM
  INSTALL
  OTHER
}

enum MediaUploadSessionStatus {
  INITIATED
  COMPLETED
  FAILED
  EXPIRED
}

enum ReceiptStatus {
  NEW
  REVIEWED
  ARCHIVED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
}

enum ReceiptOcrProvider {
  OPENAI_VISION
  GOOGLE_VISION
  TESSERACT
}

enum ReceiptOcrStatus {
  PENDING
  COMPLETED
  FAILED
}

enum JobGeoSource {
  PROPERTY_ADDRESS
  MANUAL_PIN
  GEOCODED
}

enum ReviewRequestChannel {
  SMS
  EMAIL
}

enum ReviewRequestStatus {
  DRAFT
  QUEUED_APPROVAL
  SENT
  FAILED
}

enum ReferralRewardType {
  CREDIT
  GIFT_CARD
  DISCOUNT
}

enum ReferralEventStatus {
  INVITED
  LEAD_CREATED
  WON
  REWARDED
  VOID
}

enum WebsiteIntakeType {
  CONTACT
  PRICE_MATCH
}

enum WebsiteIntakeStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeadType {
  RESIDENTIAL_SINGLE
  RESIDENTIAL_MULTI_PROPERTY
  COMMERCIAL
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT_SET
  ESTIMATE_SENT
  WON
  LOST
  NURTURE
}

enum LostOutcome {
  NO_CONTACT
  NO_SHOW
  PRICE
  TIMING
  COMPETITOR
  NOT_A_FIT
  DUPLICATE
  OTHER
}

enum LeadSitePropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum RooftopAccessType {
  NONE
  HATCH
  LADDER
  STAIRS
  UNKNOWN
}

enum AttachmentRefProvider {
  S3
  URL
}

enum EquipmentCatalogSourceType {
  CSV
}

enum EquipmentCatalogSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AssessmentAttachmentKind {
  NAMEPLATE_PHOTO
}

enum InstallType {
  COMBO
  FURNACE_ONLY
  AC_ONLY
}

enum InstallAccessType {
  STANDARD
  ATTIC
  CONFINED_CRAWLSPACE
}

enum QuotePricingMode {
  INSTALL_CUSHION20_FLOOR_ACCESS500_SALES5_DISCOUNT
}

enum QuoteKind {
  INSTALL
  SERVICE
}

enum ServiceTiming {
  NORMAL
  AFTER_HOURS
}

enum PricebookItemKind {
  SERVICE
  ADDON
  FEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum QuoteLineItemType {
  PRICEBOOK_ITEM
  CUSTOM
}

enum GuardrailStatus {
  OK
  WARNING
  REQUIRE_APPROVAL
  BLOCK
}

enum ContractClauseStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum ContractTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteBookingTriggerStatus {
  SENT
  ACCEPTED
}

enum AppointmentType {
  SERVICE_ESTIMATE
  INSTALL
}

enum AppointmentStatus {
  TENTATIVE
  BOOKED
  COMPLETED
  CANCELED
}

enum TimeBlockCode {
  BLOCK_0800_1000
  BLOCK_1000_1200
  BLOCK_1200_1400
  BLOCK_1400_1600
}

enum CommsChannel {
  IMESSAGE
  SMS
  EMAIL
}

enum CommsDirection {
  INBOUND
  OUTBOUND
}

enum CommsStatus {
  RECEIVED
  DRAFT
  QUEUED_APPROVAL
  SENT
  FAILED
}

enum CommsEntityType {
  CUSTOMER
  LEAD
  JOB
  QUOTE
}

enum ClientActionStatus {
  PENDING
  APPLIED
  FAILED
}

enum MobileSyncCursorType {
  AUDITLOG
  OUTBOX
}

enum TimeEntryType {
  SHIFT
  BREAK
  JOB
}

enum TimeEntryStatus {
  OPEN
  CLOSED
}

enum TimeEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id                       String                    @id @default(cuid())
  name                     String
  slug                     String                    @unique
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  users                    User[]
  roles                    Role[]
  apiKeys                  ApiKey[]
  policies                 Policy[]
  toolDefinitions          ToolDefinition[]
  toolExecutions           ToolExecution[]
  approvalRequests         ApprovalRequest[]
  approvalDecisons         ApprovalDecision[]
  agentRuns                AgentRun[]
  contextSnapshots         ContextSnapshot[]
  auditLogs                AuditLog[]
  outboxEvents             EventOutbox[]
  safetyState              OrgSafetyState?
  financialExposureDaily   FinancialExposureDaily[]
  importRuns               ImportRun[]
  sourceMappings           SourceMapping[]
  sourceRaws               SourceRaw[]
  attributionEvents        AttributionEvent[]
  callEvents               CallEvent[]
  trackingNumbers          TrackingNumber[]
  attachments              Attachment[]
  mediaUploadSessions      MediaUploadSession[]
  receipts                 Receipt[]
  receiptOcrResults        ReceiptOcrResult[]
  vendors                  Vendor[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  leads                    Lead[]
  customers                Customer[]
  opportunities            Opportunity[]
  pricingItems             PricingItem[]
  pricebookCategories      PricebookCategory[]
  pricebookItems           PricebookItem[]
  maintenancePlans         MaintenancePlan[]
  customerMemberships      CustomerMembership[]
  serviceBundleTemplates   ServiceBundleTemplate[]
  quotes                   Quote[]
  quoteLineItems           QuoteLineItem[]
  quoteOptions             QuoteOption[]
  contractClauses          ContractClause[]
  contractTemplates        ContractTemplate[]
  legalPacks               LegalPack[]
  jobs                     Job[]
  appointments             Appointment[]
  appointmentReservations  AppointmentReservation[]
  schedulingSettings       OrgSchedulingSettings?
  businessHours            BusinessHours[]
  blackoutDates            BlackoutDate[]
  timeBlockTemplates       TimeBlockTemplate[]
  jobGeos                  JobGeo[]
  geoRollupsDaily          GeoRollupDaily[]
  reviewRequests           ReviewRequest[]
  referralPrograms         ReferralProgram[]
  referralEvents           ReferralEvent[]
  websiteIntakeEvents      WebsiteIntakeEvent[]
  salesTasks               Task[]
  priceMatchRequests       PriceMatchRequest[]
  attachmentRefs           AttachmentRef[]
  timelineEvents           TimelineEvent[]
  leadSites                LeadSite[]
  leadSlaPolicy            LeadSlaPolicy?
  marketingMetricsDaily    MarketingMetricDaily[]
  invoices                 Invoice[]
  systemAssessments        SystemAssessment[]
  equipmentCatalogSources  EquipmentCatalogSource[]
  equipmentCatalogEntries  EquipmentCatalogEntry[]
  equipmentSpecsNormalized EquipmentSpecNormalized[]
  equipmentLookupRuns      EquipmentLookupRun[]
  assessmentAttachments    AssessmentAttachment[]
  commsAccounts            CommsAccount[]
  commsThreads             CommsThread[]
  commsMessages            CommsMessage[]
  commsEntityLinks         CommsEntityLink[]
  outboundDrafts           OutboundDraft[]
  mobileClients            MobileClient[]
  clientActions            ClientAction[]
  mobileSyncCursors        MobileSyncCursor[]
  timeEntries              TimeEntry[]
  timeEditRequests         TimeEditRequest[]
}

model User {
  id                         String               @id @default(cuid())
  orgId                      String
  email                      String
  name                       String
  phone                      String?
  employeeCode               String?
  passwordHash               String?
  mobilePinHash              String?
  mobilePinUpdatedAt         DateTime?
  mobilePinFailedAttempts    Int                  @default(0)
  mobilePinLockedUntil       DateTime?
  mobilePinResetRequired     Boolean              @default(false)
  actorType                  ActorType            @default(HUMAN)
  isActive                   Boolean              @default(true)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  organization               Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userRoles                  UserRole[]
  apiKeys                    ApiKey[]
  toolExecutions             ToolExecution[]      @relation("ToolExecutionActorUser")
  requestedApprovals         ApprovalRequest[]    @relation("ApprovalRequestedByUser")
  approvalDecisions          ApprovalDecision[]   @relation("ApprovalDecisionByUser")
  startedAgentRuns           AgentRun[]           @relation("AgentRunStartedBy")
  safetyStateUpdates         OrgSafetyState[]     @relation("OrgSafetyUpdatedBy")
  importRunsStarted          ImportRun[]          @relation("ImportRunStartedBy")
  auditLogs                  AuditLog[]
  assignedJobs               Job[]
  assignedOpportunities      Opportunity[]        @relation("OpportunityAssignedTo")
  ownedLeads                 Lead[]               @relation("LeadOwner")
  appointments               Appointment[]        @relation("AppointmentAssignedTech")
  uploadedAttachments        Attachment[]         @relation("AttachmentUploadedBy")
  createdMediaUploadSessions MediaUploadSession[] @relation("MediaUploadSessionCreatedBy")
  createdReceipts            Receipt[]            @relation("ReceiptCreatedBy")
  createdExpenses            Expense[]            @relation("ExpenseCreatedBy")
  approvedExpenses           Expense[]            @relation("ExpenseApprovedBy")
  createdReviewRequests      ReviewRequest[]      @relation("ReviewRequestCreatedBy")
  assignedSalesTasks         Task[]               @relation("SalesTaskAssignedTo")
  createdCommsMessages       CommsMessage[]       @relation("CommsMessageCreatedBy")
  createdOutboundDrafts      OutboundDraft[]      @relation("OutboundDraftCreatedBy")
  approvedOutboundDrafts     OutboundDraft[]      @relation("OutboundDraftApprovedBy")
  mobileClients              MobileClient[]
  clientActions              ClientAction[]
  timeEntries                TimeEntry[]
  timeEditRequests           TimeEditRequest[]    @relation("TimeEditRequestRequestedBy")
  reviewedTimeEditRequests   TimeEditRequest[]    @relation("TimeEditRequestReviewedBy")
  mobileSyncCursors          MobileSyncCursor[]

  @@unique([orgId, email])
  @@unique([orgId, employeeCode])
  @@index([orgId, isActive])
  @@index([orgId, phone])
}

model Role {
  id              String           @id @default(cuid())
  orgId           String
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model ApiKey {
  id           String       @id @default(cuid())
  orgId        String
  userId       String
  name         String
  keyHash      String       @unique
  isActive     Boolean      @default(true)
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, isActive])
  @@index([userId, isActive])
}

model Policy {
  id              String          @id @default(cuid())
  orgId           String
  name            String
  version         Int
  isActive        Boolean         @default(true)
  policyJson      Json
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  toolExecutions  ToolExecution[]
  agentRuns       AgentRun[]

  @@unique([orgId, name, version])
  @@index([orgId, isActive])
}

model ToolDefinition {
  id                          String            @id @default(cuid())
  orgId                       String
  name                        String
  version                     String
  description                 String?
  handlerKey                  String
  active                      Boolean           @default(true)
  riskLevel                   RiskLevel
  autonomyLevel               AutonomyLevel
  requiredPermissions         String[]
  inputSchema                 Json
  outputSchema                Json?
  cooldownSeconds             Int?
  maxCallsPerRun              Int?
  requiresReason              Boolean           @default(false)
  requiresSnapshot            Boolean           @default(false)
  endpointAllowsHumanOverride Boolean           @default(false)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  organization                Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  toolExecutions              ToolExecution[]
  approvalRequests            ApprovalRequest[]

  @@unique([orgId, name, version])
  @@index([orgId, name, active])
  @@index([riskLevel, autonomyLevel])
}

model ToolExecution {
  id                    String            @id @default(cuid())
  orgId                 String
  toolDefinitionId      String
  approvalRequestId     String?
  agentRunId            String?
  policyId              String?
  actorType             ActorType
  actorUserId           String?
  actorLabel            String?
  isAutonomous          Boolean           @default(false)
  status                ExecutionStatus
  riskLevelSnapshot     RiskLevel
  autonomyLevelSnapshot AutonomyLevel
  riskLevelAtExec       RiskLevel?
  autonomyLevelAtExec   AutonomyLevel?
  inputPayload          Json
  outputPayload         Json?
  blockedReason         String?
  errorMessage          String?
  reason                String?
  contextSnapshotId     String?
  clientActionId        String?
  correlationId         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  executedAt            DateTime?
  organization          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  toolDefinition        ToolDefinition    @relation(fields: [toolDefinitionId], references: [id], onDelete: Restrict)
  approvalRequest       ApprovalRequest?  @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  actorUser             User?             @relation("ToolExecutionActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  policy                Policy?           @relation(fields: [policyId], references: [id], onDelete: SetNull)
  agentRun              AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  contextSnapshots      ContextSnapshot[]
  contextSnapshot       ContextSnapshot?  @relation("PrimaryContextSnapshot", fields: [contextSnapshotId], references: [id], onDelete: SetNull)

  @@index([orgId, status, createdAt])
  @@index([toolDefinitionId, createdAt])
  @@index([agentRunId])
  @@index([approvalRequestId])
  @@index([contextSnapshotId])
  @@index([orgId, clientActionId])
  @@index([orgId, correlationId])
}

model ApprovalRequest {
  id                String             @id @default(cuid())
  orgId             String
  toolDefinitionId  String
  status            ApprovalStatus     @default(PENDING)
  requiredApprovals Int                @default(1)
  requestedByType   ActorType
  requestedByUserId String?
  requestPayload    Json
  reason            String?
  expiresAt         DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  toolDefinition    ToolDefinition     @relation(fields: [toolDefinitionId], references: [id], onDelete: Restrict)
  requestedByUser   User?              @relation("ApprovalRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decisions         ApprovalDecision[]
  toolExecutions    ToolExecution[]
  expenses          Expense[]
  reviewRequests    ReviewRequest[]

  @@index([orgId, status, createdAt])
  @@index([toolDefinitionId])
}

model ApprovalDecision {
  id                String          @id @default(cuid())
  orgId             String
  approvalRequestId String
  decidedByUserId   String
  status            ApprovalStatus
  comment           String?
  createdAt         DateTime        @default(now())
  organization      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  decidedByUser     User            @relation("ApprovalDecisionByUser", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@unique([approvalRequestId, decidedByUserId])
  @@index([orgId, createdAt])
}

model AgentRun {
  id               String            @id @default(cuid())
  orgId            String
  policyId         String?
  startedByUserId  String?
  goal             String
  status           AgentRunStatus
  currentSkillId   String?
  stateJson        Json?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  lastError        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policy           Policy?           @relation(fields: [policyId], references: [id], onDelete: SetNull)
  startedByUser    User?             @relation("AgentRunStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  toolExecutions   ToolExecution[]
  contextSnapshots ContextSnapshot[]

  @@index([orgId, status, createdAt])
  @@index([policyId])
}

model ContextSnapshot {
  id                       String          @id @default(cuid())
  orgId                    String
  agentRunId               String?
  toolExecutionId          String?
  snapshotJson             Json
  summary                  String?
  createdByType            ActorType
  createdByUserId          String?
  createdAt                DateTime        @default(now())
  organization             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentRun                 AgentRun?       @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  toolExecution            ToolExecution?  @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)
  primaryForToolExecutions ToolExecution[] @relation("PrimaryContextSnapshot")

  @@index([orgId, createdAt])
  @@index([agentRunId])
  @@index([toolExecutionId])
}

model AuditLog {
  id            String       @id @default(cuid())
  orgId         String
  actorType     ActorType
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorUser     User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@index([orgId, correlationId])
}

model EventOutbox {
  id            String       @id @default(cuid())
  orgId         String
  eventType     String
  correlationId String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  nextAttemptAt DateTime     @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, nextAttemptAt])
  @@index([orgId, eventType, createdAt])
  @@index([orgId, correlationId])
}

model OrgSafetyState {
  id              String       @id @default(cuid())
  orgId           String       @unique
  mode            SafetyMode   @default(NORMAL)
  reason          String?
  updatedByUserId String?
  updatedAt       DateTime     @updatedAt
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedByUser   User?        @relation("OrgSafetyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([mode, updatedAt])
}

model FinancialExposureDaily {
  id           String       @id @default(cuid())
  orgId        String
  date         DateTime     @db.Date
  bucket       String
  usedCents    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date, bucket])
  @@index([orgId, date])
}

model ImportRun {
  id              String          @id @default(cuid())
  orgId           String
  provider        ImportProvider
  mode            ImportMode
  sourceType      String
  status          ImportRunStatus @default(QUEUED)
  cursorState     Json?
  stats           Json?
  lastError       String?
  options         Json?
  startedByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  startedByUser   User?           @relation("ImportRunStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  sourceRaws      SourceRaw[]

  @@index([orgId, provider, status, createdAt])
  @@index([orgId, provider, sourceType, createdAt])
}

model SourceMapping {
  id           String         @id @default(cuid())
  orgId        String
  provider     ImportProvider
  sourceType   String
  sourceId     String
  mbsType      String
  mbsId        String
  rawHash      String
  lastSeenAt   DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider, sourceType, sourceId])
  @@index([orgId, provider, mbsType, mbsId])
  @@index([orgId, provider, sourceType, lastSeenAt])
}

model SourceRaw {
  id           String         @id @default(cuid())
  orgId        String
  provider     ImportProvider
  sourceType   String
  sourceId     String
  payload      Json
  importRunId  String?
  fetchedAt    DateTime       @default(now())
  createdAt    DateTime       @default(now())
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  importRun    ImportRun?     @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@index([orgId, provider, sourceType, fetchedAt])
  @@index([importRunId])
  @@index([orgId, provider, sourceType, sourceId, fetchedAt])
}

model Lead {
  id                  String               @id @default(cuid())
  orgId               String
  fullName            String
  email               String?
  phone               String?
  leadSource          String?
  leadType            LeadType             @default(RESIDENTIAL_SINGLE)
  stage               String               @default("NEW")
  status              String               @default("NEW")
  stageEnteredAt      DateTime             @default(now())
  lastTouchAt         DateTime?
  nextTouchDueAt      DateTime?
  lostOutcome         LostOutcome?
  lostNotes           String?
  ownerUserId         String?
  profile             Json?
  nurtureConfig       Json?
  attributionSnapshot Json?
  score               Int                  @default(0)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerUser           User?                @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  attributionEvents   AttributionEvent[]
  matchedCallEvents   CallEvent[]          @relation("CallEventMatchedLead")
  referralEvents      ReferralEvent[]      @relation("ReferralEventReferredLead")
  websiteIntakeEvents WebsiteIntakeEvent[]
  salesTasks          Task[]
