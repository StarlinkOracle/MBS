model Quote {
  id                       String            @id @default(cuid())
  orgId                    String
  leadId                   String?
  customerId               String?
  assessmentId             String?
  version                  Int               @default(1)
  kind                     QuoteKind         @default(INSTALL)
  status                   String            @default("DRAFT")
  publicToken              String?
  publicTokenExpiresAt     DateTime?
  sentAt                   DateTime?
  acceptedAt               DateTime?
  acceptedByName           String?
  acceptanceNotes          String?
  acceptedIpHash           String?
  timing                   ServiceTiming     @default(NORMAL)
  isMember                 Boolean           @default(false)
  laborHours               Float             @default(0)
  laborHoursRounded        Float             @default(0)
  laborRateCents           Int               @default(10000)
  laborTotalCents          Int               @default(0)
  subtotalCents            Int               @default(0)
  diagnosticFeeCents       Int               @default(0)
  repairSubtotalCents      Int               @default(0)
  diagnosticCreditCents    Int               @default(0)
  totalBeforeDiscountCents Int               @default(0)
  discountPctBps           Int               @default(0)
  discountCents            Int               @default(0)
  discountTotalCents       Int               @default(0)
  discountReason           String?
  finalTotalCents          Int               @default(0)
  guardrailStatus          GuardrailStatus   @default(OK)
  guardrailReasons         Json?
  totalCents               Int               @default(0)
  externalRef              String?
  issuedAt                 DateTime?
  expiresAt                DateTime?
  metadata                 Json?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  organization             Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead                     Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer                 Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assessment               SystemAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  job                      Job?              @relation("QuoteToJob")
  appointments             Appointment[]
  lineItems                QuoteLineItem[]
  options                  QuoteOption[]

  @@unique([orgId, publicToken])
  @@index([orgId, kind, status, createdAt])
  @@index([orgId, status])
  @@index([orgId, publicToken])
  @@index([orgId, sentAt])
  @@index([orgId, acceptedAt])
  @@index([orgId, externalRef])
  @@index([orgId, leadId, createdAt])
  @@index([assessmentId])
}

