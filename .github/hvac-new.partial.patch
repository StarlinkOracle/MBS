+      res.status(errorStatus(error)).json({ error: errorMessage(error) });
+    }
+  });
+
+  app.get('/api/hvac/diagnostics', async (req, res) => {
+    try {
+      const orgId = await getOrgId(req);
+      await requireAnyPermission(req, orgId, [
+        'hvac:diagnostic:read',
