+            },
+            hvacDiagnosticSessions: {
+              select: { id: true, status: true, updatedAt: true },
+              orderBy: { updatedAt: 'desc' },
+              take: 3,
+            },
+          },
+          orderBy: [{ scheduledAt: 'desc' }, { updatedAt: 'desc' }],
+          take: 80,
+        }),
+        prisma.hvacEquipmentSystem.findMany({
